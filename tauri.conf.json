{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fila de Impressão",
  "version": "0.2.0",
  "identifier": "com.tassid.fila-impressao",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Fila de Impressão",
        "width": 380,
        "height": 640,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": [22, 21, 20, 150]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
